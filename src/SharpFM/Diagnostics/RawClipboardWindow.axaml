<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SharpFM.Diagnostics.RawClipboardWindow"
    Title="FileMaker Clipboard Diagnostics"
    Width="900" Height="800" MinWidth="640" MinHeight="600"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="12">
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock TextWrapping="Wrap"
                       Text="Copy a small, non-sensitive example in FileMaker, then capture here. Capture and save do not change the clipboard or use SharpFM's normal FileMaker decoder." />
            <TextBlock TextWrapping="Wrap" Foreground="#C08000"
                       Text="Privacy: snapshots contain full clipboard payloads, including accompanying text. Scripts, credentials, and other private data may be included. Review what you copy before capturing or sharing. Nothing is uploaded automatically." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
            <TextBlock VerticalAlignment="Center" Text="FileMaker version:" />
            <TextBox Grid.Column="1" x:Name="fileMakerVersion" PlaceholderText="Optional" MaxLength="100" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Copied content:" />
            <TextBox Grid.Column="3" x:Name="captureDescription" PlaceholderText="Optional description (saved in snapshot)" MaxLength="2000" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button x:Name="captureButton" Classes="Fluent2Primary" Content="Capture FileMaker Clipboard" />
            <Button x:Name="saveButton" Classes="Fluent2" Content="Save Snapshot…" IsEnabled="False" />
        </StackPanel>

        <TextBox Grid.Row="3" x:Name="captureSummary" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="Wrap" MaxHeight="150"
                 Text="No capture yet. All discovered formats will be listed, even if no FileMaker format is recognized." />

        <Grid Grid.Row="4" RowDefinitions="*,*" RowSpacing="8">
            <ListBox x:Name="formatList" MinHeight="80" />
            <TextBox Grid.Row="1" x:Name="interpretationSummary" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" Text="Select a captured format to see retrieval details and interpretation hypotheses. Original bytes are retained separately for export." />
        </Grid>

        <Grid Grid.Row="5" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock x:Name="statusLabel" Classes="Fluent2Caption" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" x:Name="closeButton" Classes="Fluent2" Content="Close" />
        </Grid>
    </Grid>
</Window>
